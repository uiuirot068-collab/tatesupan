# TateSpun's canonical Supabase project is the project named `tatespun`.
# scripts/verify-supabase-project.mjs rejects every other project ref.
NEXT_PUBLIC_SUPABASE_URL=https://rgvqquuthovqjqfogfra.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-rgv-publishable-key

# TSP-SUPABASE-CUTOVER-GATE-001 — set these ONLY for a deliberate backend
# ref change. The two admin keys are server/build secrets; never prefix them
# with NEXT_PUBLIC_, commit them, or print them. See:
# docs/supabase/supabase-cutover-gate.md
# TATESPUN_DEPLOYED_SUPABASE_REF=rgvqquuthovqjqfogfra
# TATESPUN_CUTOVER_MANIFEST_PATH=private/cutover-manifest.json
# TATESPUN_CUTOVER_SOURCE_ADMIN_KEY=your-source-secret-or-service-role-key
# TATESPUN_CUTOVER_DESTINATION_ADMIN_KEY=your-destination-secret-or-service-role-key

# TSP-LOOP-006 β版フィードバック（β限定・公開値。true のときだけ「報告」ボタンを表示）
# Production Beta release requirement: set true in the Cloudflare Production
# environment together with the canonical URL, real anon key, and real
# Turnstile site key. Keep false for ordinary local builds.
NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=false
# 任意: レポートに載せるアプリバージョン（未設定なら 0.1.0-beta）
# NEXT_PUBLIC_APP_VERSION=

# TSP-LOOP-019: Cloudflare Turnstile の**公開 site key**（公開値。secret ではない）。
# NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=true のビルドでは必須——未設定だと
# `npm run build` / `npm run build:basepath` が失敗する（フィードバックが送れなくなるため）。
# 実際の値は Cloudflare Pages の Production / Preview 環境変数に設定する。
# secret key（TURNSTILE_SECRET_KEY）は **Supabase Edge Function 環境のみ**。repo には置かない。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# TSP-RC-AFFILIATE-FOOTER-001 HOW TO「お買い物リンク」— 公開値のみ（secret不要）。
# どちらも未設定ならセクション自体が非表示。楽天は URL のみで表示可。
# Amazon はこの2つが両方揃わない限り非表示（アソシエイト規約の必須開示文言に
# 確定した正式な運営者名称が要るため。未確認のまま推測で埋めない）。
# NEXT_PUBLIC_AMAZON_AFFILIATE_URL=https://www.amazon.co.jp/...&tag=your-associate-tag
# NEXT_PUBLIC_AMAZON_ASSOCIATE_OPERATOR_NAME=（Amazonアソシエイト規約の開示文に使う正式名称）
# NEXT_PUBLIC_RAKUTEN_AFFILIATE_URL=https://hb.afl.rakuten.co.jp/...
