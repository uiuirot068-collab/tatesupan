# TSP-LOOP-017: TateSpun uses the CANONICAL SpunTales Supabase project so a
# SpunTales account works in TateSpun with no second sign-up.
#   canonical (SpunTales): https://vjgxrqgnbgnewfvissgd.supabase.co
#   rollback  (old TateSpun-only): https://rgvqquuthovqjqfogfra.supabase.co
# scripts/verify-supabase-project.mjs enforces this. Migration runbook:
# docs/supabase/tatespun-canonical-supabase-migration.md
NEXT_PUBLIC_SUPABASE_URL=https://vjgxrqgnbgnewfvissgd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-vjg-publishable-key
# Set to 1 in Cloudflare + local ONLY AFTER the production flip to vjg is done.
# Then any NEXT_PUBLIC_SUPABASE_URL other than the canonical vjg project fails
# `npm run build` / `npm run build:basepath` (via prebuild / build-basepath step 0).
# TATESPUN_LOCK_CANONICAL=1

# TSP-LOOP-006 β版フィードバック（β限定・公開値。true のときだけ「報告」ボタンを表示）
NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=false
# 任意: レポートに載せるアプリバージョン（未設定なら 0.1.0-beta）
# NEXT_PUBLIC_APP_VERSION=

# TSP-LOOP-019: Cloudflare Turnstile の**公開 site key**（公開値。secret ではない）。
# NEXT_PUBLIC_BETA_FEEDBACK_ENABLED=true のビルドでは必須——未設定だと
# `npm run build` / `npm run build:basepath` が失敗する（フィードバックが送れなくなるため）。
# 実際の値は Cloudflare Pages の Production / Preview 環境変数に設定する。
# secret key（TURNSTILE_SECRET_KEY）は **Supabase Edge Function 環境のみ**。repo には置かない。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
